.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# IDE/editor files
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

